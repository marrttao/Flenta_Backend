# Preferred database connection key. Copy this file to .env.local for EF tooling.
# Export these variables into the API process when starting the application.
ConnectionStrings__AppDb=Host=127.0.0.1;Port=5433;Database=flenta;Username=flenta;Password=CHANGE_ME
Banking__Enabled=true
# Generate once: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
Banking__CardEncryptionKey=
Supabase__Enabled=true
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Supabase__PublishableKey=YOUR_PUBLISHABLE_KEY
Supabase__FrontendUrl=http://127.0.0.1:5173
